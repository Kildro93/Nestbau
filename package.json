{
  "name": "nestbau",
  "version": "2.0.0",
  "private": true,
  "description": "Nestbau - Haushalt Manager. PWA + Android (Capacitor).",
  "scripts": {
    "build:web": "node tools/build-web.js",
    "assets": "node tools/generate-assets.js",
    "sync": "npm run build:web && npx cap sync android",
    "android:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "puppeteer": "^25.10.0",
    "sharp": "^0.34.2"
  }
}
