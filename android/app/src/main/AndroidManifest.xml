<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        Kamera-App aufrufen duerfen. Ab Android 11 sieht eine App fremde Apps nur
        noch, wenn sie sie hier nennt - ohne diesen Block findet der Foto-Dialog
        keine Kamera-App und faellt stumm auf die Dateiauswahl zurueck.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
        Berechtigungen bewusst minimal - es bleibt bei zweien. Jede weitere Zeile
        muesste im Play-Console-Fragebogen begruendet werden und kostet
        Installationen. Begruendung siehe BUILD-GUIDE.md > Berechtigungen.
    -->

    <!-- Firestore-Sync, Kalender-Sync (Google/Microsoft) und OAuth-Login. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Bewusst NICHT angefordert:

        CAMERA - Rezept- und Zutatenfotos laufen ueber <input type="file" capture>.
        Capacitors BridgeWebChromeClient prueft in isMediaCaptureSupported(), ob die
        App CAMERA ueberhaupt deklariert: ist sie das nicht, startet es die
        System-Kamera direkt per ACTION_IMAGE_CAPTURE - ganz ohne Abfrage. Deklariert
        man CAMERA dagegen, erzwingt dieselbe Methode einen Berechtigungsdialog, der
        funktional nichts hinzufuegt. Weniger Rechte und ein Klick weniger.
        (Gilt nur solange keine In-App-Kamera ueber @capacitor/camera dazukommt.)

        READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE - die Auswahl eines vorhandenen
        Bildes laeuft ueber ACTION_GET_CONTENT. Der System-Dialog uebergibt eine
        bereits freigegebene URI, ein eigener Speicherzugriff ist unnoetig.

        READ_CALENDAR / WRITE_CALENDAR - der Kalender-Sync laeuft ueber die Google-
        und Microsoft-Graph-APIs mit OAuth, nicht ueber den Geraetekalender.

        READ_CONTACTS - Haushaltsmitglieder werden in der App angelegt, das
        Adressbuch wird nie gelesen.
    -->
</manifest>
