# Vorlage. Kopieren nach android/keystore.properties und Werte eintragen.
# Die echte Datei ist per .gitignore ausgeschlossen und darf nie committet werden.
storeFile=C:/Users/<benutzer>/.nestbau-keys/nestbau-release.jks
storePassword=<store-passwort>
keyAlias=nestbau-release
keyPassword=<key-passwort>
