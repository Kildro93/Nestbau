{
  "manifest_version": 3,
  "name": "Nestbau Rezept-Clipper",
  "version": "1.0.0",
  "description": "Rezepte von Websites und Instagram mit einem Klick in die Nestbau-App uebernehmen.",
  "minimum_chrome_version": "116",

  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Zu Nestbau speichern",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "externally_connectable": {
    "matches": [
      "https://nestbau-app.web.app/*",
      "https://nestbau-app.firebaseapp.com/*",
      "http://localhost/*"
    ]
  },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+N", "mac": "Command+Shift+N" },
      "description": "Nestbau-Clipper oeffnen"
    }
  }
}
